/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local (single machine) execution profile — sized for the development MacBook
    (docs/decisions/003: colima VM 8 CPU / 20 GB; kb count's sort buffer follows task.memory)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor       = 'local'
    resourceLimits = [ cpus: 8, memory: '16.GB', time: '48.h' ]
}

executor {
    cpus   = 8
    memory = '18.GB'
}

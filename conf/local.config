/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Local (single machine) execution profile — sized for the development MacBook
    (docs/decisions/003: colima VM 8 CPU / 20 GB; kb count's sort buffer follows task.memory)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    executor       = 'local'
    resourceLimits = [ cpus: 8, memory: '16.GB', time: '48.h' ]

    // Per-process sizing so QC and quantification can run concurrently inside the 18 GB executor budget.
    // FastQC needs ~1.5 GB RSS but is single-threaded per file under Rosetta and takes hours on 15 GB of reads;
    // kb count's bustools sort buffer follows task.memory (-m = memory - 1 GB).
    withName: 'FASTQC' {
        cpus   = 4
        memory = 4.GB
    }
    withName: 'KALLISTOBUSTOOLS_COUNT' {
        cpus   = 6
        memory = 12.GB
    }
    withName: 'GUIDE_COUNT' {
        cpus   = 4
        memory = 8.GB
    }
    withName: 'KALLISTOBUSTOOLS_REF' {
        cpus   = 6
        memory = 12.GB
    }
}

executor {
    cpus   = 8
    memory = '18.GB'
}

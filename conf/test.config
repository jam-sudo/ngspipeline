/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run jam-sudo/ngspipeline -profile test,<docker/singularity> --outdir <OUTDIR>

    Data: assets/test_data — Replogle 2022 K562 essential-scale GEM group lane_4, 120 cells + 300
    background barcodes, UMI-family subsampled; mini genome of 200 genes (docs/decisions/008).
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '10.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function (bin/make_test_data.sh)'

    // Input data (paths relative to the pipeline directory; resolved in the input subworkflow)
    input      = "${projectDir}/assets/samplesheet_test.csv"
    guides     = "${projectDir}/assets/guide_library_test.csv"
    fasta      = "${projectDir}/assets/test_data/ref/mini_genome.fa.gz"
    gtf        = "${projectDir}/assets/test_data/ref/mini_genome.gtf.gz"
    chemistry  = '10XV3'
    // NEEDS_HUMAN: test-only values for the assignment thresholds (PLAN.md T-13: production defaults are set by the human)
    assign_method = 'threshold'
    min_umi       = 5
    min_ratio     = 3
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Settings of the full-size validation run in the README (one Replogle 2022 K562 GEM group).
    The full FASTQ, guide library and kb index are not hosted, so supply them:

        nextflow run jam-sudo/ngspipeline -profile test_full,<docker/singularity> \
            --input <samplesheet> --guides <guide_library> --reference_index <kb_index> --outdir <OUTDIR>

    `nf-core pipelines download` also inspects this profile, so it has to exist.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full-size validation settings; supply --input, --guides and --reference_index'

    chemistry     = '10XV3'
    // the thresholds the README validation numbers were measured with (the pipeline defaults are 10 / 3)
    assign_method = 'threshold'
    min_umi       = 5
    min_ratio     = 3
}

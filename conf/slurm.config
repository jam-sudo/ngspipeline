/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SLURM execution profile (T-30) — written for the Northeastern Discovery cluster, not yet run there
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    NEEDS_HUMAN before first use: partition name(s), account/QOS if required, whether Singularity/Apptainer
    is the container runtime on the cluster (use `-profile slurm,singularity`), and a scratch path for the
    work directory. Nothing below is a guess about the cluster: values are parameters the human fills in
    (`params.slurm_partition`, `params.slurm_account`) or Nextflow defaults.
----------------------------------------------------------------------------------------
*/

process {
    executor       = 'slurm'
    queue          = { params.slurm_partition ?: error("Set --slurm_partition for -profile slurm (NEEDS_HUMAN)") }
    clusterOptions = { [ params.slurm_account ? "--account=${params.slurm_account}" : '', params.slurm_extra ?: '' ].join(' ').trim() }
    // Memory/time follow conf/base.config labels; cap to a typical shared-node envelope
    resourceLimits = [ cpus: 32, memory: '180.GB', time: '24.h' ]
    // transient scheduler/network failures on shared clusters
    errorStrategy  = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries     = 2
}

executor {
    queueSize       = 50
    submitRateLimit = '10 sec'
    pollInterval    = '30 sec'
}

// Container images are pulled once and shared between tasks; set to a project scratch path on the cluster.
singularity {
    cacheDir = System.getenv('NXF_SINGULARITY_CACHEDIR') ?: "${System.getenv('HOME')}/.singularity_cache"
}

/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/ngspipeline/'
}

// Cap resources for unit tests on laptops / CI runners
process {
    resourceLimits = [ cpus: 4, memory: '10.GB', time: '1.h' ]
    // Copy (not symlink) staged inputs: the synthetic test inputs live in the repository, outside the
    // nf-test work directory, and Nextflow 25.10 with Docker on GitHub runners does not mount their
    // real location, so the symlinks dangle inside the container (CI-only failure, T-20).
    stageInMode    = 'copy'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true

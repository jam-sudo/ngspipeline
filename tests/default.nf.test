nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            // stable_path: All files + folders in ${params.outdir}/ with a stable path (including file name)
            // multiqc_plots/** is excluded: the set of plot files depends on the MultiQC build (conda vs container)
            def stable_path = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ['pipeline_info/*.{html,json,txt}', 'multiqc/multiqc_plots/**'])
            // stable_content: All files in ${params.outdir}/ with stable content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            // GEX count matrix dimensions (T-11 DoD: cells >= 80% of the 120 test-data cells)
            def mtx_header = path("$outputDir/counts/replogle_k562_lane4_test/counts_filtered/cells_x_genes.mtx").readLines().find { !it.startsWith('%') }
            def (cells, genes, nnz) = mtx_header.trim().split(/\s+/).collect { it as int }
            assert workflow.success
            assert cells >= 96 && cells <= 120
            assert genes == 200
            assert path("$outputDir/guides/replogle_k562_lane4_test/guide_counts.h5ad").exists()
            def guide_header = path("$outputDir/guides/replogle_k562_lane4_test/counts_unfiltered/cells_x_features.mtx").readLines().find { !it.startsWith('%') }
            def (gbc, gfeat, gnnz) = guide_header.trim().split(/\s+/).collect { it as int }
            assert gfeat == 108   // rows of assets/guide_library_test.csv (T-12 DoD)
            assert path("$outputDir/alive/replogle_k562_lane4_test.h5ad").exists()   // T-14 DoD
            assertAll(
                { assert snapshot(
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we test pipelines on multiple Nextflow versions
                    // interpreter patch versions (python) differ between the conda and container builds of the same environment, so they are dropped
                    removeNextflowVersion("$outputDir/pipeline_info/ngspipeline_software_mqc_versions.yml").collectEntries { proc, tools -> [ (proc): (tools instanceof Map ? tools.findAll { t, v -> t != 'python' } : tools) ] },
                    // All stable path name, with a relative path
                    stable_path,
                    // All files with stable contents
                    stable_content,
                    [cells: cells, genes: genes, nnz: nnz, guide_barcodes: gbc, guide_features: gfeat, guide_nnz: gnnz]
                ).match() }
            )
        }
    }
}
